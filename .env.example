# Firebase Web（公開設定）
VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_ID=
VITE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Admin（サーバー専用）
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# データベース・Dify（サーバー専用）
DATABASE_URL=postgresql://localhost:5432/koitre
DIFY_API_BEARER_TOKEN=
DIFY_UID_SIGNING_SECRET=
# 新しい練習画面。準備・検証が完了するまで false を維持する。
PRACTICE_ENABLED=false
DIFY_PRACTICE_API_KEY=
DIFY_API_BASE_URL=https://api.dify.ai/v1
# 最終回の観点別評価。未設定・障害時も会話に基づく文章分析は継続する。
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# お問い合わせフォームの通知。Resendで認証したドメインの送信元を指定する。
RESEND_API_KEY=
CONTACT_MAIL_FROM=

# 評価方針・知識の管理。Firebaseの確認済みUIDだけをカンマ区切りで設定する。
# 既存のUID許可リストは維持する。
KOITRE_ADMIN_UIDS=
# 追加管理者のGoogleメール。確認済みメール＋Googleログインだけを許可する。
# 両リストが空なら管理権限を誰にも付与しない。実際の値はサーバー設定だけに置く。
KOITRE_ADMIN_GOOGLE_EMAILS=
# trueかつ公開版がある場合、新しく始まる練習へ適用する。
KNOWLEDGE_POLICY_ENABLED=false

# 新規購入を有効にする設定。販売開始まではProductionでfalseを維持する。
BILLING_ENABLED=false
# 分離したテスト環境専用のStripeキー。
STRIPE_SECRET_KEY=
# ProductionのCheckoutとCustomer Portalセッションを作る制限付きキー。
STRIPE_LIVE_BILLING_API_KEY=
# Stripeの配信先ごとの署名シークレット。本番とテストは別の値を使う。
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_WEBHOOK_ENABLED=false
# 本番WebhookがStripeの購入・契約・請求・返金・紛争を照合するための読み取り専用キー。
STRIPE_LIVE_WEBHOOK_API_KEY=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_TOPUP=
STRIPE_PRICE_ROUTE_AOI=
STRIPE_PRICE_ROUTE_RIN=
STRIPE_PRICE_ROUTE_SHIORI=
STRIPE_PRICE_ROUTE_YU=
STRIPE_PRICE_ROUTE_SOTA=
STRIPE_PRICE_ROUTE_REN=
STRIPE_PORTAL_CONFIGURATION_ID=

# GA4 サーバー送信。API シークレットは Vercel の Production にだけ登録する。
GA4_API_SECRET=
# 以下は GA4 管理 CLI 用。プロパティ ID は G- で始まる計測 ID とは別。
GA4_PROPERTY_ID=
# GA4_USE_ADC=true
# GA4_QUOTA_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/ga-admin-service-account.json

VITE_APP_DOMAIN=https://app.koi-tre.com
VITE_APP_TITLE=Koi-Tre

# ローカルE2E検証のみ。demo- で始まる専用プロジェクトに限定する。
# VITE_PROJECT_ID=demo-koi-tre-practice
# FIREBASE_PROJECT_ID=demo-koi-tre-practice
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
