{
  "name": "koi-tre-auth",
  "version": "0.0.1",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/check-vercel-output.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:integration": "vitest run",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:seo": "node scripts/check-public-pages.mjs",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "prepare": "svelte-kit sync && pnpm run smui-theme",
    "smui-theme": "smui-theme compile static/smui.css -i src/theme -i node_modules",
    "dify:config": "node ./scripts/show-dify-config.mjs",
    "ga:list": "node ./scripts/ga-admin.mjs list",
    "ga:sync": "node ./scripts/ga-admin.mjs sync",
    "ga:sync:dry": "node ./scripts/ga-admin.mjs sync --dry-run",
    "db:generate": "drizzle-kit generate",
    "db:generate:prod": "NODE_ENV=production pnpm db:generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "NODE_ENV=production pnpm db:migrate",
    "db:reset": "node ./scripts/reset-db.mjs && pnpm db:setup",
    "db:reset:prod": "NODE_ENV=production pnpm db:reset",
    "db:status": "node ./scripts/show-db-status.mjs",
    "db:status:prod": "NODE_ENV=production pnpm db:status",
    "db:seed": "tsx ./scripts/seed-from-supabase-dump.ts",
    "db:seed:prod": "NODE_ENV=production pnpm db:seed",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "db:setup:prod": "pnpm db:migrate:prod && pnpm db:seed:prod"
  },
  "type": "module",
  "dependencies": {
    "@material/theme": "^14.0.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.5",
    "firebase": "^10.11.1",
    "firebase-admin": "^13.4.0",
    "postgres": "^3.4.7",
    "stripe": "23.1.0",
    "svelte-markdown": "^0.4.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@fontsource/fira-mono": "^4.5.10",
    "@google-analytics/admin": "^10.2.0",
    "@neoconfetti/svelte": "^1.0.0",
    "@smui/button": "^7.0.0",
    "@smui/card": "^7.0.0",
    "@smui/list": "^7.0.0",
    "@smui/menu": "^7.0.0",
    "@sveltejs/adapter-vercel": "5.10.3",
    "@sveltejs/kit": "2.17.2",
    "@sveltejs/vite-plugin-svelte": "3.1.2",
    "@types/eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.31.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.35.1",
    "postcss": "^8.4.38",
    "prettier": "^3.1.1",
    "prettier-plugin-svelte": "^3.1.2",
    "smui-theme": "^7.0.0",
    "svelte": "4.2.20",
    "svelte-check": "^3.6.0",
    "tailwindcss": "^3.4.3",
    "tslib": "^2.4.1",
    "tsx": "^4.19.4",
    "typescript": "^5.5.4",
    "vite": "^5.0.3",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "cookie": "^0.7.0",
    "undici": "6.21.1"
  }
}
